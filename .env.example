# ─── Database ─────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./amazon_intelligence.db
# For PostgreSQL: DATABASE_URL=postgresql://user:password@localhost:5432/amazon_intelligence

# ─── MLflow ───────────────────────────────────────────────────────
MLFLOW_TRACKING_URI=http://localhost:5000

# ─── Training Mode ────────────────────────────────────────────────
# Set to "true" to use fast CPU simulation mode (no GPU needed)
FAST_SIMULATE=true

# ─── HuggingFace ──────────────────────────────────────────────────
# Optional: set to a local directory to cache models
# HF_HOME=/path/to/model/cache
